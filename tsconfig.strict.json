{
  // Full `strict` for every file under src/, enforced by scripts/typecheck-strict.mjs (run as part
  // of `npm run typecheck`). tsconfig.json is the floor for all files; this is the ratchet on top.
  //
  // New files are strict by default. `legacyStrictErrors` is the ceiling of strict-mode errors a
  // pre-existing file may still have. It may only go down: the check fails if a file gets worse
  // OR better, so a fix has to lower the number here (delete the entry at 0). Never raise one or
  // add a file: write the new code with real types instead.
  //
  // Burn-down: `npx tsc -p tsconfig.strict.json --pretty false | grep <file>`.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": true
